{
  "name": "slidesv",
  "version": "1.0.0",
  "description": "Zero-dependency SVG-based presentation engine and compiler",
  "type": "module",
  "scripts": {
    "build:index": "node scripts/build-index.ts",
    "serve": "node cli.ts serve demo-deck",
    "build:demo": "node cli.ts build demo-deck --out demo-deck/dist/presentation.html",
    "test": "node --test tests/core.test.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
